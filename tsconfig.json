{
	"compilerOptions": {
		"strict": true,
		"types": ["node"],
		"esModuleInterop": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
